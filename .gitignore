# ============================================================
# AI-Driven Digital Twin for Smart Healthcare
# Git Ignore
# ============================================================


# ============================================================
# PYTHON
# ============================================================

__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
wheels/


# ============================================================
# TESTING / COVERAGE
# ============================================================

.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/


# ============================================================
# JUPYTER
# ============================================================

.ipynb_checkpoints/


# ============================================================
# ENVIRONMENT / SECRETS
# ============================================================

.env
.env.*
!.env.example

*.pem
*.key
*.secret
*.credentials

secrets/
credentials/
config.local.*


# ============================================================
# DATASETS
# IMPORTANT:
# Never commit MIMIC/eICU/VitalDB or other clinical datasets.
# Directory placeholders (.gitkeep) remain trackable.
# ============================================================

# ------------------------------------------------------------
# MIMIC-IV
# ------------------------------------------------------------

data/raw/mimic_iv/*
data/raw/mimic_iv_demo/*
data/raw/mimic-iv/*
data/raw/mimic-iv-demo/*

# Allow directory placeholders
!data/raw/mimic_iv/.gitkeep
!data/raw/mimic_iv_demo/.gitkeep
!data/raw/mimic-iv/.gitkeep
!data/raw/mimic-iv-demo/.gitkeep


# ------------------------------------------------------------
# MIMIC-CXR
# ------------------------------------------------------------

data/raw/mimic_cxr/*
data/raw/mimic-cxr/*
data/raw/mimic_cxr_jpg/*
data/raw/mimic-cxr-jpg/*

!data/raw/mimic_cxr/.gitkeep
!data/raw/mimic-cxr/.gitkeep
!data/raw/mimic_cxr_jpg/.gitkeep
!data/raw/mimic-cxr-jpg/.gitkeep


# ------------------------------------------------------------
# Other clinical datasets
# ------------------------------------------------------------

data/raw/eicu/*
data/raw/vitaldb/*
data/raw/mimic_waveform/*

!data/raw/eicu/.gitkeep
!data/raw/vitaldb/.gitkeep
!data/raw/mimic_waveform/.gitkeep


# ------------------------------------------------------------
# Generic downloaded clinical data
# ------------------------------------------------------------

data/raw/**/*.csv
data/raw/**/*.csv.gz
data/raw/**/*.parquet
data/raw/**/*.parquet.gz
data/raw/**/*.json
data/raw/**/*.json.gz
data/raw/**/*.tsv
data/raw/**/*.tsv.gz
data/raw/**/*.txt


# ------------------------------------------------------------
# Medical images / waveforms
# ------------------------------------------------------------

data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.dcm
data/**/*.dicom
data/**/*.edf
data/**/*.wfdb


