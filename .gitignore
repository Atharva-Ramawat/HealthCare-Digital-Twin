# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
.vite/
.parcel-cache/

# React environment files
frontend/.env
frontend/.env.*
!frontend/.env.example

# ------------------------------------------------------------
# TypeScript
# ------------------------------------------------------------
*.tsbuildinfo

