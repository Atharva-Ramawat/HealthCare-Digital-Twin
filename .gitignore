# ============================================================
# AI-Driven Digital Twin for Smart Healthcare
# Git Ignore
# ============================================================

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
wheels/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ------------------------------------------------------------
# Jupyter
# ------------------------------------------------------------
.ipynb_checkpoints/

# ------------------------------------------------------------
# Environment / Secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example

*.pem
*.key
secrets/
credentials/
config.local.*

# ------------------------------------------------------------
# MIMIC-IV / MIMIC-CXR DATA
# IMPORTANT: DO NOT COMMIT CLINICAL DATA
# ------------------------------------------------------------

# Raw MIMIC-IV
data/raw/mimic_iv/
data/raw/mimic_iv_demo/
data/raw/mimic-iv/
data/raw/mimic-iv-demo/

# Raw MIMIC-CXR
data/raw/mimic_cxr/
data/raw/mimic-cxr/
data/raw/mimic_cxr_jpg/
data/raw/mimic-cxr-jpg/

# Any downloaded datasets
data/raw/**/*.csv
data/raw/**/*.csv.gz
data/raw/**/*.parquet
data/raw/**/*.json
data/raw/**/*.json.gz
data/raw/**/*.tsv
data/raw/**/*.tsv.gz

# CXR images
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.dcm
data/**/*.dicom

# ------------------------------------------------------------
# Large generated datasets
# ------------------------------------------------------------
data/processed/
data/interim/
data/cache/

*.parquet
*.parquet.gz

# Keep directory structure documentation if needed
!data/raw/.gitkeep
!data/processed/.gitkeep

# ------------------------------------------------------------
# Machine Learning Models / Checkpoints
# ------------------------------------------------------------

# PyTorch
*.pt
*.pth
*.ckpt

# TensorFlow / Keras
*.h5
*.keras
*.pb

# ONNX
*.onnx

# ML checkpoints
models/checkpoints/
ml/**/checkpoints/
ml/**/outputs/

# TensorBoard
runs/
tensorboard/
lightning_logs/

# Weights & Biases
wandb/
.wandb/

# ------------------------------------------------------------
# Generated ML outputs
# ------------------------------------------------------------
outputs/
results/
artifacts/

# Keep reports that are intentionally committed
!ml/**/PHASE*_REPORT.md
!ml/**/TARGET_DEFINITIONS.md

# ------------------------------------------------------------
# Python application logs
# ------------------------------------------------------------
*.log
logs/

# ------------------------------------------------------------
# FastAPI
# ------------------------------------------------------------
.fastapi/
uvicorn.log

