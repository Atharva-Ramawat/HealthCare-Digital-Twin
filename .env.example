# Copy this file to .env and fill in your values.
# Never commit the actual .env file.

# Project root (auto-detected if omitted)
# DT_PROJECT_ROOT=

# MIMIC-IV access (PhysioNet credentials)
PHYSIONET_USER=
PHYSIONET_PASSWORD=

# VitalDB API key (if required)
VITALDB_API_KEY=

# Dashboard
DT_DASHBOARD_PORT=8501

# Logging level (DEBUG, INFO, WARNING, ERROR)
DT_LOG_LEVEL=INFO
